# ==============================================================================
# MoFA Engine — Environment Variables & Cloud Provider Keys
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Or run the interactive key configurator:
#   bash quickstart.sh keys
# ==============================================================================

# 1. Google Gemini Cloud Provider (Chat + Reasoning + Native Audio TTS)
# Free Tier available at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. OpenAI Cloud Provider (GPT-4o + Whisper ASR + DALL-E-3)
# Key available at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# 3. DeepSeek Reasoning Provider (DeepSeek-R1 Deep Thinking)
# Key available at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# 4. Fireworks AI Provider (Serverless Open Models)
# Key available at: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=""

# 5. MoFA Gateway Security (Optional Bearer Token)
# If set, all /v1 requests must pass Authorization: Bearer <token>
MOFA_API_TOKEN=""
