# Example environment for mofa-studio (and any app using the Agnes / Ark backends).
#
# Copy this to `.env.local` (gitignored), fill in your key, then:
#   source .env.local && cargo run -p mofa-studio
#
# `.env.local` is NOT auto-loaded by the app — you `source` it so the values land
# in the process environment, where the engine resolves `api_key = "env:VAR"`.

# --- Agnes AI (free omni-modal gateway) — chat + image + video ---
# Get a free key at https://agnes-ai.com. This one key enables all three.
export AGNES_API_KEY=""

# Endpoint + model ids (defaults shown; override only if the docs change):
export AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
export AGNES_CHAT_MODEL="agnes-2.5-flash"
export AGNES_IMAGE_MODEL="agnes-image-2.1-flash"
export AGNES_VIDEO_MODEL="agnes-video-v2.0"      # or "agnes-video-2.5"

# --- Seedance via Volcengine Ark (alternative video backend) ---
# Only needed if you use the Ark dialect instead of Agnes for video.
# export ARK_API_KEY=""
