{
  "title": "MoFA Memory & Lifecycle",
  "refresh": "10s",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "type": "gauge",
      "title": "Memory Utilization",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "mofa_memory_used_bytes / mofa_memory_budget_bytes * 100",
          "legendFormat": "% Used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage vs Budget",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 6 },
      "targets": [
        {
          "expr": "mofa_memory_used_bytes",
          "legendFormat": "Used"
        },
        {
          "expr": "mofa_memory_budget_bytes",
          "legendFormat": "Budget"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "barchart",
      "title": "Model Loads (Total)",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum by (model) (mofa_model_loads_total) > 0",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Model Unloads by Reason",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum by (reason) (mofa_model_unloads_total) > 0",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total Evictions",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(mofa_evictions_total) or vector(0)",
          "legendFormat": "Evictions"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Cold Load Duration Heatmap",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(mofa_model_load_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    }
  ]
}
