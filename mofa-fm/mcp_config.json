{
  "mcpServers": {
    "mofa-engine": {
      "command": "python3",
      "args": ["mofa-fm/mcp_server.py"],
      "env": {}
    }
  },
  "_setup_instructions": {
    "claude_desktop": {
      "path": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "config": {
        "mcpServers": {
          "mofa-engine": {
            "command": "python3",
            "args": ["<PATH_TO_MOFA_ENGINE>/mofa-fm/mcp_server.py"]
          }
        }
      }
    },
    "cursor": {
      "path": ".cursor/mcp.json",
      "config": {
        "mcpServers": {
          "mofa-engine": {
            "command": "python3",
            "args": ["mofa-fm/mcp_server.py"]
          }
        }
      }
    }
  }
}
